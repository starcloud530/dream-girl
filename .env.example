# Copy to repo-root `.env` (or `~/.dream-girl/.env` if you adapt paths).
# Never commit real keys.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional cloud TTS fallback when local Qwen is down
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Runtime paths (AutoDL defaults shown)
DREAM_GIRL_ROOT=/root/autodl-tmp/dream-girl
DREAM_GIRL_MODELS_ROOT=/root/autodl-fs/models
DREAM_GIRL_LOG_DIR=/root/autodl-tmp/dream-girl-logs

FLASHHEAD_CONFIG=configs/t1_384_stack.yaml
FACE_PREROLL_MS=1400
FACE_OUT_MS=1400
FACE_OUT_FOLLOW_MS=1400
FACE_JOB_MS=1400
FACE_MSE_FORMAT=fmp4
